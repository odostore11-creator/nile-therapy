# Copy this file to .env and fill in.
PORT=3000
# Get this from console.anthropic.com once you have credits. Leave empty for placeholder mode.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (default) or claude-opus-5-5
DEFAULT_MODEL=claude-sonnet-5-5
# Set to 1 once the site is served over HTTPS
COOKIE_SECURE=0
# Set to 0 to start with no demo doctors/sessions (do this for the real launch)
SEED_DEMO=1
